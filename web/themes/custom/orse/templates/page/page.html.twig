{% set short_description = node.field_short_description.value %}

{% set image_bg_url = page_title_image_url %}
{% if node.field_header_background_image and node.field_header_background_image.value %}
      {% set image_bg_url = file_url(node.field_header_background_image.entity.uri.value) %}
{% endif %}

<div class="offcanvas-menu">
	<div id="btn" class="dark">
		<div id='top'></div>
		<div id='middle'></div>
		<div id='bottom'></div>
	</div>
	<div id="box">
		{% if page.menu_side %}
			{{ page.menu_side }}
		{% endif %}
		<div class="clearfix"></div>
		<div class="contact-info">
			{% if page.menu_side_bottom %}
				{{ page.menu_side_bottom }}
			{% endif %}
		</div>
	</div>
</div>
<div class="col-md-12 nopadding">
	<div class="header-section white style1 links-dark pin-style">
		<div class="container">
			<div class="mod-menu">
				<div class="row">
					{% if page.header %}
						{{ page.header }}
					{% endif %}
					<div class="col-sm-10">
						<div class="main-nav">
							<ul class="nav navbar-nav top-nav">
								<li class="search-parent">
									<a href="javascript:void(0)" title="" class="m-link">
										<i aria-hidden="true" class="fa fa-search"></i>
									</a>
									{% if page.search %}
										{{ page.search }}
									{% endif %}
								</li>
								<li class="cart-parent">
									{% if page.header_cart %}
										{{ page.header_cart }}
									{% endif %}
								</li>
								<li class="visible-xs menu-icon">
									<a href="javascript:void(0)" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#menu" aria-expanded="false">
										<i aria-hidden="true" class="fa fa-bars"></i>
									</a>
								</li>
							</ul>
							{% if page.main_menu %}
								{{ page.main_menu }}
							{% endif %}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<div class="clearfix"></div>


<section class="page-title-4" style="background-image: url({{ image_bg_url }})">
    <div class="container">
        <div class="row">
            <h1 class="font-weight-8 text-center">{{ title }}</h1>
            {% if short_description %}<h5 class="font-weight-5 text-center less2">{{ short_description|raw }}</h5>{% endif %}
        </div>
    </div>
</section>
<div class="clearfix"></div>
{% if ntype != 'page' %}
	<section class="sec-padding">
	    <div class="container">
	        <div class="row">
	            <div class="col-md-12 col-sm-12 col-xs-12">
	                {{ page.content_full_bar }}
	                {{ page.content }}
	            </div>
	        </div>
	    </div>
	</section>
{% else %}
	{{ page.slider }}
	{{ page.content_full_bar }}
    {{ page.section }}
	{{ page.content }}
{% endif %}

<footer class="section-dark sec-tpadding-2">
	<div class="container sec-bpadding-6">
		<div class="row">
			{% if page.footer_column_1 %}
				{{ page.footer_column_1 }}
			{% endif %}

			{% if page.footer_column_2 %}
				{{ page.footer_column_2 }}
			{% endif %}

			{% if page.footer_column_3 %}
				{{ page.footer_column_3 }}
			{% endif %}

			{% if page.footer_column_4 %}
				{{ page.footer_column_4 }}
			{% endif %}

			<div class="clearfix"></div>
			<div class="col-divider-margin-2"></div>
		</div>
	</div>
	<div class="container-fluid section-dark two sec-moreless-padding">
		<div class="container">
			<div class="col-md-6 col-sm-12 col-xs-12 margin-bottom text-left respo text-white opacity-5">
				{% if copyright_text %}
					{{ copyright_text|raw }}
				{% endif %}
			</div>
			<div class="col-md-6 col-sm-12 col-xs-12 text-right respo">
				{% if social_network_footer %}
					{{ social_network_footer|raw }}
				{% endif %}
			</div>
		</div>
	</div>
</footer>
