{% set image_bg_url = page_title_image_url %}
{% if node.field_header_background_image and node.field_header_background_image.value %}
      {% set image_bg_url = file_url(node.field_header_background_image.entity.uri.value) %}
{% endif %}

{% if header_style == 'style2' %}
    {% include theme_path ~ "/templates/header/header-2.html.twig" %}
{% elseif header_style == 'style3' %}
    {% include theme_path ~ "/templates/header/header-3.html.twig" %}
{% elseif header_style == 'style4' %}
    {% include theme_path ~ "/templates/header/header-4.html.twig" %}
{% else %}
    {% include theme_path ~ "/templates/header/header-1.html.twig" %}
{% endif %}

<section class="page-title-4" style="background-image: url({{ image_bg_url }})">
    <div class="container">
        <div class="row">
            <h1 class="font-weight-8 text-center">{{ title }}</h1>
        </div>
    </div>
</section>
<div class="clearfix"></div>
{% set term_machine_name = current_term.vid.value.0.target_id %}
{% if term_machine_name == 'blog_categories' %}
	<section class="sec-padding">
	    <div class="container">
	        <div class="row">
	            <div class="col-md-8">
	                {{ page.content_full_bar }}
	            	{{ page.content }}
	            </div>
	            <div class="col-md-4 col-sm-12 col-xs-12 section-white">
	                {% if page.sidebar %}{{ page.sidebar }}{% endif %}
	            </div>
	        </div>
	    </div>
	</section>
{% elseif term_machine_name == 'tags'%}
	<section class="sec-padding">
	    <div class="container">
	        <div class="row">
	            <div class="col-md-8">
	                {{ page.content_full_bar }}
	            	{{ page.content }}
	            </div>
	            <div class="col-md-4 col-sm-12 col-xs-12 section-white">
	                {% if page.sidebar %}{{ page.sidebar }}{% endif %}
	            </div>
	        </div>
	    </div>
	</section>
{% elseif term_machine_name == 'product_categories' or term_machine_name == 'product_tags' %}
	<section class="sec-padding">
	    <div class="container">
	        <div class="row">
	            <div class="col-md-9 col-sm-12 col-xs-12">
	                {{ page.content_full_bar }}
	                {% if product_taxonomy_term_content %}
					    {% for a in product_taxonomy_term_content %}
					        {{ a|t }}
					    {% endfor %}
					{% endif %}
					{{ product_txnm_pager ? product_txnm_pager|t }}
	            </div>
	            <div class="col-md-3 col-sm-12 col-xs-12 margin-bottom">
	                {% if page.sidebar_shop %}{{ page.sidebar_shop }}{% endif %}    
	            </div>
	        </div>
	    </div>
	</section>
	<div class="clearfix"></div>
{% else %}
	<section class="sec-padding">
	    <div class="container">
	        <div class="row">
	            {{ page.content_full_bar }}
	            {{ page.content }}
	        </div>
	    </div>
	</section>
{% endif %}
<div class="clearfix"></div>
{% if term_machine_name == 'product_categories' or term_machine_name == 'product_tags' %}
	{% include theme_path ~ "/templates/footer/footer-product.html.twig" %}
{% else %}
	{% if footer_style == 'style1' %}
	    {% include theme_path ~ "/templates/footer/footer-1.html.twig" %}
	{% elseif footer_style == 'style2' %}
	    {% include theme_path ~ "/templates/footer/footer-2.html.twig" %}
	{% elseif footer_style == 'style3' %}
	    {% include theme_path ~ "/templates/footer/footer-3.html.twig" %}
	{% else %}  
	    
	{% endif %}
{% endif %}