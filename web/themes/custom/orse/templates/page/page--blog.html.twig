{% set image_bg_url = page_title_image_url %}
{% if node.field_header_background_image and node.field_header_background_image.value %}
      {% set image_bg_url = file_url(node.field_header_background_image.entity.uri.value) %}
{% endif %}

{% if header_style == 'style2' %}
    {% include theme_path ~ "/templates/header/header-2.html.twig" %}
{% elseif header_style == 'style3' %}
    {% include theme_path ~ "/templates/header/header-3.html.twig" %}
{% elseif header_style == 'style4' %}
	{% include theme_path ~ "/templates/header/header-4.html.twig" %}
{% else %}
	{% include theme_path ~ "/templates/header/header-1.html.twig" %}
{% endif %}

{% set sidebar = blog_sidebar %}

<section class="page-title-4" style="background-image: url({{ image_bg_url }})">
    <div class="container">
        <div class="row">
            <h1 class="font-weight-8 text-center">{{ title }}</h1>
        </div>
    </div>
</section>
<div class="clearfix"></div>

{% if blog_layout == 'classic' %}
	{% if sidebar == 'none' %}
		<section class="sec-padding">
		    <div class="container">
		        <div class="row">
		        	{% if sidebar == 'left'%}
			            <div class="col-md-4">
			                <div class="col-md-12 col-sm-12 col-xs-12 pull-right">
			                    {% if page.sidebar %}{{ page.sidebar }}{% endif %}
			                </div>
			            </div>
		        	{% endif %}
		            <div class="{{ class }} nopadding">
		                {{ page.content_full_bar }}
	                	{{ page.content }}
		            </div>
		            {% if sidebar == 'right'%}
			            <div class="col-md-4">
			                <div class="col-md-8 col-sm-12 col-xs-12 pull-right">
			                    {% if page.sidebar %}{{ page.sidebar }}{% endif %}
			                </div>
			            </div>
		        	{% endif %}
		        </div>
		    </div>
		</section>
		<div class="clearfix"></div>
	{% else %}
		<section class="sec-padding">
		    <div class="container-fluid">
		        <div class="row">
		        	{% if sidebar == 'left'%}
			            <div class="col-md-4">
			                <div class="col-md-8 col-sm-12 col-xs-12 pull-right">
			                    {% if page.sidebar %}{{ page.sidebar }}{% endif %}
			                </div>
			            </div>
		        	{% endif %}
		            <div class="col-md-8 nopadding">
		                {{ page.content_full_bar }}
	                	{{ page.content }}
		            </div>
		            {% if sidebar == 'right'%}
			            <div class="col-md-4">
			                <div class="col-md-8 col-sm-12 col-xs-12">
			                    {% if page.sidebar %}{{ page.sidebar }}{% endif %}
			                </div>
			            </div>
		        	{% endif %}
		        </div>
		    </div>
		</section>
		<div class="clearfix"></div>
	{% endif %}
{% elseif blog_layout == 'default'%}
	{% if sidebar == 'none' %}
		<section class="sec-padding section-light">
		    <div class="container">
		        <div class="row">
		        	{% if sidebar == 'left'%}
			            <div class="col-md-4 col-sm-12 col-xs-12 section-white">
			                {% if page.sidebar %}{{ page.sidebar }}{% endif %}
			            </div>
		        	{% endif %}
		            <div class="col-md-12 nopadding">
		                {{ page.content_full_bar }}
		            	{{ page.content }}
		            </div>
		            {% if sidebar == 'right'%}
			            <div class="col-md-4 col-sm-12 col-xs-12 section-white">
			                {% if page.sidebar %}{{ page.sidebar }}{% endif %}
			            </div>
		        	{% endif %}
		        </div>
		    </div>
		</section>
		<div class="clearfix"></div>
	{% else %}
		<section class="sec-padding">
		    <div class="container">
		        <div class="row">
		        	{% if sidebar == 'left'%}
			            <div class="col-md-4 col-sm-12 col-xs-12 section-white">
			                {% if page.sidebar %}{{ page.sidebar }}{% endif %}
			            </div>
		        	{% endif %}
		            <div class="col-md-8">
		                {{ page.content_full_bar }}
	                	{{ page.content }}
		            </div>
		            {% if sidebar == 'right'%}
			            <div class="col-md-4 col-sm-12 col-xs-12 section-white">
			                {% if page.sidebar %}{{ page.sidebar }}{% endif %}
			            </div>
		        	{% endif %}
		        </div>
		    </div>
		</section>
		<div class="clearfix"></div>
	{% endif %}
{% elseif blog_layout == 'thumb' %}
	{% if sidebar == 'none' %}
		<section class="sec-padding">
		    <div class="container">
		        <div class="row">
	                {{ page.content_full_bar }}
                	{{ page.content }}
		        </div>
		    </div>
		</section>
		<div class="clearfix"></div>
	{% else %}
		<section class="sec-padding">
		    <div class="container">
		        <div class="row">
		        	{% if sidebar == 'left'%}
			            <div class="col-md-4 col-sm-12 col-xs-12">
			                {% if page.sidebar %}{{ page.sidebar }}{% endif %}
			            </div>
		        	{% endif %}
		            <div class="col-md-8 col-sm-12 col-xs-12">
		                {{ page.content_full_bar }}
	                	{{ page.content }}
		            </div>
		            {% if sidebar == 'right'%}
			            <div class="col-md-4 col-sm-12 col-xs-12">
			                {% if page.sidebar %}{{ page.sidebar }}{% endif %}
			            </div>
		        	{% endif %}
		        </div>
		    </div>
		</section>
		<div class="clearfix"></div>
	{% endif %}
{% elseif blog_layout == '1column' %}
	<section class="sec-padding section-light">
	    <div class="container">
	        <div class="row">
	            <div class="col-md-12 nopadding">
	                {{ page.content_full_bar }}
                	{{ page.content }}
	            </div>
	        </div>
	    </div>
	</section>
	<div class="clearfix"></div>
{% elseif blog_layout == '5column'%}
	<section class="sec-padding section-light">
	    <div class="container-fluid">
	        <div class="row five-cols">
	            {{ page.content_full_bar }}
               	{{ page.content }}
	        </div>
	    </div>
	</section>
	<div class="clearfix"></div>
{% elseif blog_layout == '6column' %}
	<section class="sec-padding section-light">
	    <div class="container-fluid">
	        <div class="row">
	            {{ page.content_full_bar }}
               	{{ page.content }}
	        </div>
	    </div>
	</section>
	<div class="clearfix"></div>
{% else %}
	<section class="sec-padding section-light">
	    <div class="container">
	        <div class="row">
                {{ page.content_full_bar }}
            	{{ page.content }}
	        </div>
	    </div>
	</section>
	<div class="clearfix"></div>
{% endif %}

{% if footer_style == 'style1' %}
	{% include theme_path ~ "/templates/footer/footer-1.html.twig" %}
{% elseif footer_style == 'style2' %}
    {% include theme_path ~ "/templates/footer/footer-2.html.twig" %}
{% elseif footer_style == 'style3' %}
    {% include theme_path ~ "/templates/footer/footer-3.html.twig" %}
{% else %}	
	
{% endif %}