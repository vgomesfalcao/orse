{%
  set body_classes = [
    logged_in ? 'user-logged-in',
    not root_path ? 'path-frontpage' : 'path-' ~ root_path|clean_class,
    node_type ? 'page-node-type-' ~ node_type|clean_class,
    db_offline ? 'db-offline',
    theme.settings.navbar_position ? 'navbar-is-' ~ theme.settings.navbar_position,
    theme.has_glyphicons ? 'has-glyphicons',
    node_type,
  ]
%}

<!DOCTYPE html>
<html lang="en">
    <head>
        <head-placeholder token="{{ placeholder_token|raw }}">
        <title>{{ head_title|safe_join(' | ') }}</title>
        <css-placeholder token="{{ placeholder_token|raw }}">
        <js-placeholder token="{{ placeholder_token|raw }}">

        {% if general_setting_tracking_code != '' %}
            {{ general_setting_tracking_code|t }}
        {% endif %}
        {% if custom_css != '' %}
            <style type="text/css" media="all">
                {{ custom_css|t }}
            </style>
        {% endif %}
        <link id="switch-colors" rel="stylesheet" type="text/css" href="{{ apar_theme_path  ~ '/css/color-primary/' ~ apar_css_skin_pr ~ '.css' }}">
        <link id="switch-colors-2" rel="stylesheet" type="text/css" href="{{ apar_theme_path ~ '/css/color-secondary/' ~ apar_css_skin_sc ~ '.css' }}">
    </head>
    {% if layout_page == 'boxed' %}
        {% if background_styles == 'image' %}
            <body class="apar-boxed" style="background: url({{ page_image_bg }}) {{ page_bg_css }};">
        {% else %}
            <body class="apar-boxed" style="background: {{ background_color }};">
        {% endif %}
    {% else %}
    {# <body class="{{node_type}}"> #}
    <body {{ attributes.addClass(body_classes) }} >
    {% endif %}
        {% if display_preloader %}
            <div class="over-loader loader-live">
                <div class="loader">
                    {% if preloader_style == "style1" %}
                        <div class="loader-item style5">
                            <div class="bounce1"></div>
                            <div class="bounce2"></div>
                            <div class="bounce3"></div>
                        </div>
                    {% elseif preloader_style == "style2" %}
                        <div class="loader-item style2"></div>
                    {% elseif preloader_style == "style3" %}
                        <div class="loader-item style3">
                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                            <div></div>
                        </div>
                    {% elseif preloader_style == "style4" %}
                        <div class="loader-item style4">
                            <div class="cube1"></div>
                            <div class="cube2"></div>
                        </div>
                    {% elseif preloader_style == "style5" %}
                        <div class="loader-item style6">
                            <div class="sk-cube sk-cube1"></div>
                            <div class="sk-cube sk-cube2"></div>
                            <div class="sk-cube sk-cube3"></div>
                            <div class="sk-cube sk-cube4"></div>
                            <div class="sk-cube sk-cube5"></div>
                            <div class="sk-cube sk-cube6"></div>
                            <div class="sk-cube sk-cube7"></div>
                            <div class="sk-cube sk-cube8"></div>
                            <div class="sk-cube sk-cube9"></div>
                        </div>
                    {% elseif preloader_style == "style6" %}
                        <div class="loader-item style7">
                            <div></div>
                            <div></div>
                        </div>
                    {% elseif preloader_style == "style7" %}
                        <div class="loader-item style8">
                            <div></div>
                        </div>
                    {% elseif preloader_style == "style8" %}
                        <div class="loader-item style9">
                            <div></div>
                            <div></div>
                            <div></div>
                        </div>
                    {% else %}
                        <div class="loader-item style10">
                            <div></div>
                            <div></div>
                            <div></div>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endif %}
        {% if display_switch %}
            <section id="style-customizer">
                <div class="style-customizer-wrap form-horizontal">
                    <h4 class="sc-header uppercase">Style Customizer</h4>
                    <h5 class="uppercase">Layout Style</h5>
                    <div class="sc-variable-row form-group">
                        <div class="radio-group col-xs-12">
                            <input type="radio" name="sc-layout-type" id="sc-layout-type-boxed" class="sc-variable" data-key="layoutType" value="boxed" checked>
                            <input type="radio" name="sc-layout-type" id="sc-layout-type-wide" class="sc-variable" data-key="layoutType" value="wide">
                            <label for="sc-layout-type-wide" class="style-fweight-normal">Wide</label>
                            <label for="sc-layout-type-boxed" class="style-fweight-normal">Boxed</label>
                        </div>
                    </div>
                    <h5 class="customizer-style-tytle-padd uppercase apar-text-switcher">Color Options</h5>
                    <label for="sc-color-prim" class="control-label color-text">Primary Color</label>
                    <ul class="styles" id="apr-color-pr">
                        <li><a href="javascript:void(0)" data-color='default-pr'><span class="pre-color-skin1"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='orange-pr'><span class="pre-color-skin2"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='lightgreen-pr'><span class="pre-color-skin3"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='blue-pr'><span class="pre-color-skin4"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='green-pr'><span class="pre-color-skin5"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='red-pr'><span class="pre-color-skin6"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='cyan-pr'><span class="pre-color-skin7"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='purple-pr'><span class="pre-color-skin8"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='pink-pr'><span class="pre-color-skin9"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='brown-pr'><span class="pre-color-skin10"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='yellow-pr'><span class="pre-color-skin11"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='purple-2-pr'><span class="pre-color-skin12"></span></a></li>
                    </ul>
                    <label for="sc-color-prim" class="control-label color-text">Secondary Color</label>
                    <ul class="styles" id="apr-color-sc">
                        <li><a href="javascript:void(0)" data-color='default-sc'><span class="pre-color-skin1"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='orange-sc'><span class="pre-color-skin2"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='lightgreen-sc'><span class="pre-color-skin3"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='blue-sc'><span class="pre-color-skin4"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='green-sc'><span class="pre-color-skin5"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='red-sc'><span class="pre-color-skin6"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='cyan-sc'><span class="pre-color-skin7"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='purple-sc'><span class="pre-color-skin8"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='pink-sc'><span class="pre-color-skin9"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='brown-sc'><span class="pre-color-skin10"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='yellow-sc'><span class="pre-color-skin11"></span></a></li>
                        <li><a href="javascript:void(0)" data-color='purple-2-sc'><span class="pre-color-skin12"></span></a></li>
                    </ul>
                </div>
                <button id="sc-toggle" title="Styles Customizer"><i class="fa fa-wrench"></i> </button>
            </section>
        {% endif %}
        <div id="apar-theme-path" class="hidden" data-apar-theme-path="{{ base_path ~ theme_path }}"></div>
        <div id="apar-map" class="hidden" data-lat="{{ nvs_geolocation_lat }}" data-lang="{{ nvs_geolocation_lang }}" ></div>
        <div class="wrapper-boxed">
            <div class="site-wrapper">
                <a href="#main-content" class="visually-hidden focusable">
                    {{ 'Skip to main content'|t }}
                </a>
                {{ page_top }}
                {{ page }}
                {{ page_bottom }}
            </div>
        </div>
        <js-bottom-placeholder token="{{ placeholder_token|raw }}">
        <a href="#" class="scrollup">Scroll</a>
    </body>
</html>
