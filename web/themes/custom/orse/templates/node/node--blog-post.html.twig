{% set format = node.field_blog_format.value %}
{% if format == '' %}
  {% set format = 'image' %}
{% endif %}
{% set comment_count = node.field_blog_comments.comment_count %}
{% set user_name = node.getRevisionAuthor().name.value %}
{% if page %}
	{% if format == 'gallery' %}
		<div class="carousel_holder">
		    <div class="bg2-featurebox-6">
		        <div id="sync1" class="owl-carousel">
		        	{% for k,gallery in (node.field_blog_image) %}
		        		{% set gallery_url_ori = getUrlByImageStyle(gallery.entity.uri.value, 'image_1000x900') %}
						<div class="item"><img src="{{ gallery_url_ori }}" alt="{{ node.getTitle() }}" class="img-responsive"></div>
					{% endfor %}
		        </div>
		    </div>
		    <br/>
		    <div class="ce4-feature-box-42">
		        <div id="sync2" class="owl-carousel">
		        	{% for k,gallery in (node.field_blog_image) %}
		        		{% set gallery_url_tb = getUrlByImageStyle(gallery.entity.uri.value, 'image_200x150') %}
						<div class="item"><img src="{{ gallery_url_tb }}" alt="{{ node.getTitle() }}" class="img-responsive"></div>
					{% endfor %}
		        </div>
		    </div>
		</div>
		<div class="clearfix"></div>
		<br/>
		<br/>
		<div class="bg2-featurebox-3">
		    <h4 class="dosis uppercase title"><a href="{{ url }}">{{ node.getTitle() }} </a></h4>
		    <div class="blog-post-info"><span><i class="fa fa-comments-o"></i> {{ comment_count }} {{'Comments'|raw }}</span> <span><i class="fa fa-folder"></i> {{ content.field_blog_tags }}</span></div>
		    <br/>
		    {{ content.body }}
		    <br/>
		    <h5>{{ 'Share This Article'|raw }}</h5>
		    <ul class="footer-social-icons">
			    <li><a href="http://twitter.com/share?url={{ pageURL }}&amp;text={{ title }}" target="_blank"><i class="fa fa-twitter"></i></a></li>

			    <li><a href="http://www.facebook.com/sharer/sharer.php?u={{ pageURL }}&t={{ title }}" target="_blank"><i class="fa fa-facebook"></i></a></li>

			    <li><a href="https://plus.google.com/share?url={{ pageURL }}" target="_blank"><i class="fa fa-google-plus"></i></a></li>

			    <li><a href="http://pinterest.com/pin/create/link/?url={{ pageURL }}" target="_blank"><i class="fa fa-pinterest"></i></a></li>
			</ul>
		</div>
	{% elseif format == 'video' %}
		<div class="bg2-featurebox-3">
		    {{ content.field_video_embed }}
		    <div class="postinfo-box">
		        <h4 class="dosis uppercase title"><a href="{{ url }}">{{ node.getTitle() }} </a></h4>
		        <div class="blog-post-info"><span><i class="fa fa-comments-o"></i> {{ comment_count }} {{'Comments'|raw }}</span> <span><i class="fa fa-folder"></i> {{ content.field_blog_tags }}</span></div>
		        <br/>
		        {{ content.body }}
		        <br/>
		        <h5>{{ 'Share This Article'|raw }}</h5>
		        <ul class="footer-social-icons">
				    <li><a href="http://twitter.com/share?url={{ pageURL }}&amp;text={{ title }}" target="_blank"><i class="fa fa-twitter"></i></a></li>

				    <li><a href="http://www.facebook.com/sharer/sharer.php?u={{ pageURL }}&t={{ title }}" target="_blank"><i class="fa fa-facebook"></i></a></li>

				    <li><a href="https://plus.google.com/share?url={{ pageURL }}" target="_blank"><i class="fa fa-google-plus"></i></a></li>

				    <li><a href="http://pinterest.com/pin/create/link/?url={{ pageURL }}" target="_blank"><i class="fa fa-pinterest"></i></a></li>
				</ul>
		    </div>
		</div>
	{% else %}
		<div class="bg2-featurebox-3">
		    <div class="img-box">
		        <div class="postdate-box">
		            <div class="blog-post-info"> <span><i class="fa fa-user"></i> {{ 'By'|raw }} {{ user_name }}</span> <span><i class="fa fa-comments-o"></i> {{ comment_count }} {{ 'Comments'|raw }}</span> </div>
		        </div>
		        {% set image_url = getUrlByImageStyle(node.field_blog_image.entity.uri.value, 'image_1200x750') %}
		        <img src="{{ image_url }}" alt="{{ node.getTitle() }}" class="img-responsive"/> 
		    </div>
		    <div class="postinfo-box">
			    <h4 class="dosis uppercase title"><a href="{{ url }}">{{ node.getTitle() }} </a></h4>
			    <div class="blog-post-info"><span><i class="fa fa-comments-o"></i> {{ comment_count }} Comments</span> <span><i class="fa fa-folder"></i> {{ content.field_blog_tags }}</span></div>
			    <br/>
			    {{ content.body }}
			    <br/>
			    <h5>{{ 'Share This Article'|raw }}</h5>
			    <ul class="footer-social-icons">
				    <li><a href="http://twitter.com/share?url={{ pageURL }}&amp;text={{ title }}" target="_blank"><i class="fa fa-twitter"></i></a></li>

				    <li><a href="http://www.facebook.com/sharer/sharer.php?u={{ pageURL }}&t={{ title }}" target="_blank"><i class="fa fa-facebook"></i></a></li>

				    <li><a href="https://plus.google.com/share?url={{ pageURL }}" target="_blank"><i class="fa fa-google-plus"></i></a></li>

				    <li><a href="http://pinterest.com/pin/create/link/?url={{ pageURL }}" target="_blank"><i class="fa fa-pinterest"></i></a></li>
				</ul>
			</div>
		</div>
	{% endif %}
	<div class="clearfix"></div>
	<br/>
	{{ content.field_blog_comments }}
{% else %}
	<div class="bg2-featurebox-3">
	    <div class="img-box">
	        <div class="postdate-box">
	            <div class="blog-post-info"> <span><i class="fa fa-user"></i> {{ 'By'|raw }} {{ user_name }}</span> <span><i class="fa fa-comments-o"></i> {{ comment_count }} {{ 'Comments'|raw }}</span> </div>
	        </div>
	        {% set image_url = getUrlByImageStyle(node.field_blog_image.entity.uri.value, 'image_1200x550') %}
	        <img src="{{ image_url }}" alt="{{ node.getTitle() }}" class="img-responsive"/> 
	    </div>
	    <div class="postinfo-box">
	        <h4 class="dosis uppercase title"><a href="{{ url }}">{{ node.getTitle() }} </a></h4>
	        <div class="blog-post-info"><span><i class="fa fa-comments-o"></i> {{ comment_count }} {{ 'Comments'|raw }}</span> <span><i class="fa fa-folder"></i> {{ content.field_blog_tags }}</span> </div>
	        <br/>
	        <p>{{ node.body.summary|length > 458 ? node.body.summary|slice(0,458) ~ '...' : node.body.summary }}</p>
	        <br/>
	        <br/>
	        <a class="btn btn-dark-3 btn-small uppercase" href="{{ url }}">{{ 'Read more'|raw }}</a> 
	    </div>
	</div>
{% endif %}