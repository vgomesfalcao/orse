{% if product_layout == '2column' %}
	<div class="col-md-6 col-sm-6 col-xs-12 pd-list-item">
	    <div class="sp-feature-box-3 margin-bottom">
	        <div class="img-box">
	            <a href="{{ product_url }}" class="view-btn uppercase">{{ 'View'|t }}</a>
	           	{% set imageone_uri = product.field_product_image['#items'].entity.uri.value %}
				{% set imageone_url = getUrlByImageStyle(imageone_uri,'image_750x750')%}
	            <img src="{{ imageone_url }}" alt="{{ product.field_product_image['#items'].alt }}" class="img-responsive"/> 
	        </div>
	        <div class="clearfix"></div>
	        <br/>
	        <h4 class="less-mar-1">{{ product.title }}</h4>
	        <p>{{ product_entity.body.summary }}</p>
	        <h5 class="text-gyellow">{{ product.variation_price }}</h5>
	        <br/>
	        {{ product.variations }} 
	    </div>
	</div>
