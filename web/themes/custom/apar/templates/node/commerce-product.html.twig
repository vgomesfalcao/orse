{% set product_sidebar = product_entity.field_product_sidebar.value %}
{% if product_sidebar == '' %}
   {% set product_sidebar = 'none' %}
{% endif %}
{% if product_sidebar == 'left' %}
	<div class="product_preview_left">
	    <div class="gallery">
	        <div class="full">
	            {% set imageone_uri = product.field_product_image['#items'].entity.uri.value %}
				{% set imageone_url = file_url(imageone_uri) %}
	            <img src="{{ imageone_url }}"  alt="{{ product.field_product_image['#items'].alt }}"/> 
	        </div>
	        <div class="previews"> 
				{% for image in product.field_product_image['#items'] %}
					{% set imageone_uri_tb = image.entity.uri.value %}
					{% set imageone_url_tb = getUrlByImageStyle(imageone_uri_tb,'image_150x150')%}
					{% set imageone_url_full = file_url(image.entity.uri.value)%}
		            <a data-full="{{ imageone_url_full }}"><img src="{{ imageone_url_tb }}" alt="{{ image.alt }}" /></a> 
		        {% endfor %} 
	        </div>
	    </div>
	</div>
	<div class="col-md-6 col-sm-12 col-xs-12 apar-pd-ct">
	    <br/><br/>
	    <h4 class="uppercase">{{ product.title }}</h4>
	    <div class="divider-line solid light"></div>
	    <br/>
	    <div class="col-md-5 col-sm-12 col-xs-12">
	        <h2 class="text-gyellow font-weight-4">{{ product.variation_price }}</h2>
	    </div>
	    <div class="clearfix"></div>
	    {{ product.body  }}
	    <div class="clearfix"></div>
	    <br/>
	    {{ product.variations }}
	</div>
	<div class="col-md-6 col-sm-12 col-xs-12">
	    <br/><br/>
	    <div class="pro-details"><span>{{ 'Product ID :'|t }}</span> {{ product.variation_sku }}</div>
	    <div class="pro-details"><span>{{ 'Category :'|t }}</span> {{ product.field_product_categories }}</div>
	    <div class="pro-details"><span>{{ 'Tags :'|t }}</span> {{ product.field_product_tags }}</div>
	    <div class="clearfix"></div>
	    <br/><br/>
	    <ul class="sp-sc-icons">
	        <li><a class="twitter" href="http://twitter.com/share?url={{ pageURL }}&amp;text={{ product_entity.title.value }}" target="_blank"><i class="fa fa-twitter"></i></a></li>
	        <li><a href="http://www.facebook.com/sharer/sharer.php?u={{ pageURL }}&t={{ product_entity.title.value }}" target="_blank"><i class="fa fa-facebook"></i></a></li>
	        <li><a class="active" href="https://plus.google.com/share?url={{ pageURL }}" target="_blank"><i class="fa fa-google-plus"></i></a></li>
	        <li><a href="http://pinterest.com/pin/create/link/?url={{ pageURL }}" target="_blank"><i class="fa fa-pinterest"></i></a></li>
	    </ul>
	</div>
