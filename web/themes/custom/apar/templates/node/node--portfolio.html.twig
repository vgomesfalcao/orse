{% set portfolio_format = node.field_portfolio_format.value %}
{% if portfolio_format == '' %}
  {% set portfolio_format = 'image' %}
{% endif %}

{% set sidebar = node.field_portfolio_sidebar.value %}
{% if sidebar == '' %}
  {% set sidebar = 'none' %}
{% endif %}

{% set project_by = node.field_project_by.value %}
{% set skills = node.field_skills.value %}
{% set client = node.field_client.value %}
{% set date_time = node.field_date_time.value %}
{% set portfolio_categories = node.field_portfolio_categories.value %}
{% set website = node.field_website.value %}
{% set website_uri = website.0.uri %}
{% set website_title = website.0.title %}
{% if sidebar == 'none' %}
	{% if portfolio_format == 'image' %}
		<div class="col-md-12">
			{% set image_url = getUrlByImageStyle(node.field_portfolio_image.entity.uri.value, 'image_2000x900') %}
		    <img src="{{ image_url }}" alt="{{ node.getTitle() }}" class="img-responsive"/>                        
		</div>
	{% elseif portfolio_format == 'parallax' %}
		{% set image_url = file_url(node.field_portfolio_image.entity.uri.value) %}
		<div class="parallax vertical-align" data-parallax-bg-image="{{ image_url }}" data-parallax-speed="1" data-parallax-direction="down">
		    <div class="parallax-overlay bg-opacity-1">
		        <div class="container sec-more-padding-1">
		            <div class="row">
		                <div class="text-box padding-percent-3">
		                </div>
		            </div>
		        </div>
		    </div>
		</div>
	{% elseif portfolio_format == 'video' %}
		{{ content.field_video_embed }}
	{% else %}
		<div id="owl-demo2" class="owl-carousel owl-theme">
			{% for k,gallery in (node.field_portfolio_image) %}
				{% set gallery_url = getUrlByImageStyle(gallery.entity.uri.value, 'image_2000x900') %}
				<div class="item">
			        <div class="col-md-12">
			            <img src="{{ gallery_url }}" alt="{{ node.getTitle() }}" class="img-responsive"/>
			        </div>
			    </div>
			{% endfor %}
		</div>
	{% endif %}
	<div class="col-divider-margin-6"></div>
	<div class="col-md-6">
	    <ul class="port-project-info">
	        {% if project_by %}<li><span>{{ 'Project by:'|raw }}</span> {{ project_by }}</li>{% endif %}
	        {% if date_time %}<li><span>{{ 'date:'|raw }}</span> {{ content.field_date_time }}</li>{% endif %}
	        {% if skills %}<li><span>{{ 'Skills:'|raw }}</span> {{ skills }}</li>{% endif %}
	        {% if client %}<li><span>{{ 'Client:'|raw }}</span>{{ client }}</li>{% endif %}
	        {% if website %}<li><span>{{ 'Website:'|raw }}</span> <a href="{{ website_uri }}" class="primary">{{ website_title }}</a></li>{% endif %}
	    </ul>
	    <div class="clearfix"></div>
	    <ul class="social-icons h-anim-rotate socila-sm">
	        <li class="hover-facebook">
	            <a href="http://www.facebook.com/sharer/sharer.php?u={{ pageURL }}&t={{ title }}" target="_blank">
	            <i class="fa fa-facebook" aria-hidden="true"></i>
	            </a>
	        </li>
	        <li class="hover-twitter">
	            <a href="http://twitter.com/share?url={{ pageURL }}&amp;text={{ title }}" target="_blank">
	            <i class="fa fa-twitter" aria-hidden="true"></i>
	            </a>
	        </li>
	        <li class="hover-google-plus">
	            <a href="https://plus.google.com/share?url={{ pageURL }}" target="_blank">
	            <i class="fa fa-google-plus" aria-hidden="true"></i>
	            </a>
	        </li>
	        <li class="hover-pinterest">
	            <a href="http://pinterest.com/pin/create/link/?url={{ pageURL }}" target="_blank">
	            <i class="fa fa-pinterest" aria-hidden="true"></i>
	            </a>
	        </li>
	    </ul>
	</div>
	<!--end item-->
	<div class="col-md-6">
	    <h3 class="font-weight-7">{{ 'Project description'|raw }}</h3>
	    {{ content.field_description }}
	</div>
{% else %}
	{% if portfolio_format == 'image' %}
		<div class="col-md-12">
			{% set image_url = getUrlByImageStyle(node.field_portfolio_image.entity.uri.value, 'image_2000x900') %}
		    <img src="{{ image_url }}" alt="{{ node.getTitle() }}" class="img-responsive"/>                        
		</div>
	{% elseif portfolio_format == 'parallax' %}
		{% set image_url = getUrlByImageStyle(node.field_portfolio_image.entity.uri.value, 'image_2000x900') %}
		<div class="parallax vertical-align" data-parallax-bg-image="{{ image_url }}" data-parallax-speed="1" data-parallax-direction="down">
		    <div class="parallax-overlay bg-opacity-1">
		        <div class="container sec-more-padding-1">
		            <div class="row">
		                <div class="text-box padding-percent-3">
		                </div>
		            </div>
		        </div>
		    </div>
		</div>
	{% elseif portfolio_format == 'video' %}
		{{ content.field_video_embed }}
	{% else %}
		<div id="owl-demo2" class="owl-carousel owl-theme">
			{% for k,gallery in (node.field_portfolio_image) %}
				{% set gallery_url = getUrlByImageStyle(gallery.entity.uri.value, 'image_2000x900') %}
				<div class="item">
			        <div class="col-md-12">
			            <img src="{{ gallery_url }}" alt="{{ node.getTitle() }}" class="img-responsive"/>
			        </div>
			    </div>
			{% endfor %}
		</div>
	{% endif %}
	<div class="col-divider-margin-6"></div>
	<div class="col-md-12">
	    <ul class="port-project-info">
	        {% if project_by %}<li><span>{{ 'Project by:'|raw }}</span> {{ project_by }}</li>{% endif %}
	        {% if date_time %}<li><span>{{ 'date:'|raw }}</span> {{ content.field_date_time }}</li>{% endif %}
	        {% if skills %}<li><span>{{ 'Skills:'|raw }}</span> {{ skills }}</li>{% endif %}
	        {% if client %}<li><span>{{ 'Client:'|raw }}</span>{{ client }}</li>{% endif %}
	        {% if website %}<li><span>{{ 'Website:'|raw }}</span> <a href="{{ website_uri }}" class="primary">{{ website_title }}</a></li>{% endif %}
	    </ul>
	    <div class="clearfix"></div>
	    <ul class="social-icons h-anim-rotate socila-sm">
	        <li class="hover-facebook">
	            <a href="http://www.facebook.com/sharer/sharer.php?u={{ pageURL }}&t={{ title }}" target="_blank">
	            <i class="fa fa-facebook" aria-hidden="true"></i>
	            </a>
	        </li>
	        <li class="hover-twitter">
	            <a href="http://twitter.com/share?url={{ pageURL }}&amp;text={{ title }}" target="_blank">
	            <i class="fa fa-twitter" aria-hidden="true"></i>
	            </a>
	        </li>
	        <li class="hover-google-plus">
	            <a href="https://plus.google.com/share?url={{ pageURL }}" target="_blank">
	            <i class="fa fa-google-plus" aria-hidden="true"></i>
	            </a>
	        </li>
	        <li class="hover-pinterest">
	            <a href="http://pinterest.com/pin/create/link/?url={{ pageURL }}" target="_blank">
	            <i class="fa fa-pinterest" aria-hidden="true"></i>
	            </a>
	        </li>
	    </ul>
	</div>
	<div class="clearfix"></div>
	<br/><br/>
	<div class="col-md-12">
	    <h4 class="font-weight-7">{{ 'Project description'|raw }}</h4>
	    {{ content.field_description }}
	</div>
{% endif %}

