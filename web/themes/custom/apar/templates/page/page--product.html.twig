{% set header_style = product_entity.field_header_style_pd.value %}
{% if header_style == '' %}
   {% set header_style = 'style4' %}
{% endif %}

{% set product_sidebar = product_entity.field_product_sidebar.value %}
{% if product_sidebar == '' %}
   {% set product_sidebar = 'none' %}
{% endif %}

{% set short_description = product_entity.field_short_description_pd.value %}

{% set image_bg_url = page_title_image_url %}
{% if product_entity.field_header_background_image_pd and product_entity.field_header_background_image_pd.value %}
      {% set image_bg_url = file_url(product_entity.field_header_background_image_pd.entity.uri.value) %}
{% endif %}

{% if header_style == 'style2' %}
    {% include theme_path ~ "/templates/header/header-2.html.twig" %}
{% elseif header_style == 'style3' %}
    {% include theme_path ~ "/templates/header/header-3.html.twig" %}
{% elseif header_style == 'style4' %}
    {% include theme_path ~ "/templates/header/header-4.html.twig" %}
{% else %}
    {% include theme_path ~ "/templates/header/header-1.html.twig" %}
{% endif %}

<section class="page-title-4" style="background-image: url({{ image_bg_url }})">
    <div class="container">
        <div class="row">
            <h1 class="font-weight-8 text-center">{{ title }}</h1>
            {% if short_description %}<h5 class="font-weight-5 text-center less2">{{ short_description|raw }}</h5>{% endif %}
        </div>
    </div>
</section>
<div class="clearfix"></div>

{% if product_sidebar == 'left' %}
    <section class="sec-padding">
        <div class="container">
            <div class="row">
                <div class="col-md-3 col-sm-12 col-xs-12 margin-bottom">
                    {% if page.sidebar_shop %}{{ page.sidebar_shop }}{% endif %}    
                </div>

                <div class="col-md-9 col-sm-12 col-xs-12">
                    {{ page.content_full_bar }}
                    {{ page.content }}
                    <div class="clearfix"></div>
                    <br/><br/>
                    <div class="divider-line solid light"></div>
                    <br/><br/>
                    <div class="col-xs-12 nopadding">
                        <div class="sec-title-container text-center">
                            <h4 class="uppercase font-weight-7 less-mar-1">{{ 'Related Products'|t }}</h4>
                            <div class="sp-title-line-1"></div>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    {% for a in related_products %}
                        {{ a|raw }}
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>
    <div class="clearfix"></div>
    {{ page.section_pd }}
{% elseif product_sidebar == 'right' %}
    <section class="sec-padding">
        <div class="container">
            <div class="row">
                <div class="col-md-9 col-sm-12 col-xs-12">
                    {{ page.content_full_bar }}
                    {{ page.content }}
                    <div class="clearfix"></div>
                    <br/><br/>
                    <div class="divider-line solid light"></div>
                    <br/><br/>
                    <div class="col-xs-12 nopadding">
                        <div class="sec-title-container text-center">
                            <h4 class="uppercase font-weight-7 less-mar-1">{{ 'Related Products'|t }}</h4>
                            <div class="sp-title-line-1"></div>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    {% for a in related_products %}
                        {{ a|raw }}
                    {% endfor %}
                </div>

                <div class="col-md-3 col-sm-12 col-xs-12 margin-bottom">
                    {% if page.sidebar_shop %}{{ page.sidebar_shop }}{% endif %}    
                </div>
            </div>
        </div>
    </section>
    <div class="clearfix"></div>
    {{ page.section_pd }}
{% elseif product_sidebar == 'both' %}
    <section class="sec-padding">
        <div class="container">
            <div class="row">
                <div class="col-md-3 col-sm-12 col-xs-12 margin-bottom">
                    {% if page.sidebar_left %}{{ page.sidebar_left }}{% endif %}      
                </div>

                <div class="col-md-6 col-sm-12 col-xs-12">
                    {{ page.content_full_bar }}
                    {{ page.content }}
                </div>

                <div class="col-md-3 col-sm-12 col-xs-12 margin-bottom">
                    {% if page.sidebar_right %}{{ page.sidebar_right }}{% endif %}
                </div>

            </div>
        </div>
    </section>
    <div class="clearfix"></div>

    <section>
        <div class="divider-line solid light"></div>
        <div class="container">
            <div class="row sec-padding">
                <div class="col-xs-12 nopadding">
                    <div class="sec-title-container text-center">
                        <h4 class="uppercase font-weight-7 less-mar-1">{{ 'Related Products'|t }}</h4>
                        <div class="sp-title-line-1"></div>
                    </div>
                </div>
                <div class="clearfix"></div>
                {% for a in related_products %}
                    {{ a|raw }}
                {% endfor %}
            </div>
        </div>
    </section>
    <div class="clearfix"></div>
    {{ page.section_pd }}
{% else %}
    <section class="sec-padding">
        <div class="container">
            {{ page.content_full_bar }}
            {{ page.content }}
        </div>
    </section>
    <div class="clearfix"></div>

    <section class="sec-bpadding-2">
        <div class="container">
            <div class="row">
                <div class="col-xs-12 nopadding">
                    <div class="sec-title-container text-center">
                        <h4 class="uppercase font-weight-7 less-mar-1">{{ 'Related Products'|t }}</h4>
                        <div class="sp-title-line-1"></div>
                    </div>
                </div>
                <div class="clearfix"></div>
                {% for a in related_products %}
                    {{ a|raw }}
                {% endfor %}
            </div>
        </div>
    </section>
    <div class="clearfix"></div>
    {{ page.section_pd }}
{% endif %}

{% include theme_path ~ "/templates/footer/footer-product.html.twig" %}

    