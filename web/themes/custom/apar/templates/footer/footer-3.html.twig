<footer class="parallax" data-parallax-bg-image="{{ footer_image_url }}" data-parallax-speed="0.9" data-parallax-direction="down">
    <div class="section-overlay bg-opacity-2">
        <div class="container sec-tpadding-4 sec-bpadding-4">
            <div class="row text-left">
                {% if page.footer_column_1 %}{{ page.footer_column_1 }}{% endif %}

                {% if page.footer_column_2 %}{{ page.footer_column_2 }}{% endif %}

                {% if page.footer_column_3 %}{{ page.footer_column_3 }}{% endif %}

                {% if page.footer_column_4 %}{{ page.footer_column_4 }}{% endif %}
                <div class="clearfix"></div>
                <div class="col-divider-margin-2"></div>
            </div>
        </div>
        <div class="container-fluid section-dark two sec-moreless-padding">
            <div class="container">
                <div class="col-md-6 col-sm-12 col-xs-12 margin-bottom text-left respo text-white opacity-5">{% if copyright_text %}{{ copyright_text|raw }}{% endif %}</div>
                <div class="col-md-6 col-sm-12 col-xs-12 text-right respo">
                    {% if social_network_footer %}{{ social_network_footer|raw }}{% endif %}
                </div>
            </div>
        </div>
    </div>
</footer>