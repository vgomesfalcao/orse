<li {{ attributes.addClass('cart-parent')}}>
    <a href="javascript:void(0)" title="" class="m-link"> <i aria-hidden="true" class="fa fa-shopping-cart"></i> <span class="number mar2"> {{ count }} </span> </a>
    {% if content %}
    <div class="cart-box">
        <div class="content">
                {{ content }}
            <div class="row apar-link-cart">
                {{ links }}
            </div>
        </div>
    </div>
    {% else %}
        <div class="cart-box">
            <div class="content">
                {{'Your shopping cart is empty.'|t}}
            </div>
        </div>
    {% endif %}
</li>